// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS ──────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  MERCHANT
  ADMIN
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(CLIENT)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  whatsappNumber      String?   // Solo para Comerciante
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders              Order[]
  quotes              Quote[]
  cart                Cart?
  passwordResets      PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditUser")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id])
}

// ─── CATÁLOGO ──────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  name      String    @unique  // Polos, Poleras, Casacas
  isActive  Boolean   @default(true)
  products  Product[]
}

model SizeAttribute {
  id       String           @id @default(uuid())
  value    String           // S, M, L, XL, XXL
  isActive Boolean          @default(true)
  variants ProductVariant[]
}

model FabricAttribute {
  id       String    @id @default(uuid())
  value    String    // Algodón, Piqué, Dry Fit
  isActive Boolean   @default(true)
  products Product[]
}

model Product {
  id              String          @id @default(uuid())
  name            String
  description     String?
  basePrice       Decimal         @db.Decimal(12, 4)
  fiberComposition String?        // NTP 231.400:2020
  careInstructions String?
  isActive        Boolean         @default(true)
  categoryId      String
  fabricId        String
  category        Category        @relation(fields: [categoryId], references: [id])
  fabric          FabricAttribute @relation(fields: [fabricId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  sizeGuide       SizeGuide[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  sizeId      String
  color       String
  stock       Int       @default(0)
  price       Decimal?  @db.Decimal(12, 4)  // Sobreescribe basePrice si se define
  isActive    Boolean   @default(true)
  product     Product   @relation(fields: [productId], references: [id])
  size        SizeAttribute @relation(fields: [sizeId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  quoteItems  QuoteItem[]

  @@unique([productId, sizeId, color])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String  // Cloudinary URL
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id])
}

model SizeGuide {
  id        String  @id @default(uuid())
  productId String
  size      String
  chestCm   Float
  lengthCm  Float
  sleeveCm  Float
  product   Product @relation(fields: [productId], references: [id])
}

// ─── CARRITO ───────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  productVariantId String
  quantity         Int
  cart             Cart           @relation(fields: [cartId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
}

// ─── DESCUENTOS ────────────────────────────────────────────────────────────

model DiscountRule {
  id             String  @id @default(uuid())
  minQuantity    Int
  maxQuantity    Int?    // null = sin límite superior
  percentage     Decimal @db.Decimal(7, 4)
  description    String?
  isActive       Boolean @default(true)
}

model SeasonDiscount {
  id             String   @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  percentage     Decimal  @db.Decimal(7, 4)
  isAccumulative Boolean  @default(false)
  status         SeasonStatus @default(SCHEDULED)
  appliesTo      String[] // Categorías específicas; vacío = todas
}

enum SeasonStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  DEACTIVATED
}

// ─── PEDIDOS ───────────────────────────────────────────────────────────────

enum OrderStatus {
  REGISTERED
  IN_PRODUCTION
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  status         OrderStatus @default(REGISTERED)
  totalAmount    Decimal     @db.Decimal(12, 2)
  receiptUrl     String?     // URL del PDF del comprobante
  receiptType    String?     // 'boleta' | 'factura'
  cancelReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payment        Payment?
  statusHistory  OrderStatusHistory[]
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 4)
  discountPct      Decimal        @db.Decimal(7, 4) @default(0)
  subtotal         Decimal        @db.Decimal(12, 2)
  order            Order          @relation(fields: [orderId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  changedBy String      // userId del Comerciante o Sistema
  reason    String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id])
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String   @unique
  stripePaymentId String   @unique
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("PEN")
  status          String   // pending | confirmed | failed
  method          String   // card | yape
  paidAt          DateTime?
  order           Order    @relation(fields: [orderId], references: [id])
}

// ─── COTIZACIONES ──────────────────────────────────────────────────────────

enum QuoteStatus {
  PENDING
  QUOTED
  APPROVED
  REJECTED
  UNFEASIBLE
}

model Quote {
  id               String      @id @default(uuid())
  clientId         String
  garmentType      String
  fabricType       String
  color            String
  totalQuantity    Int
  message          String?
  designImageUrl   String?     // Cloudinary URL
  designZone       String?     // chest | back | left_arm | right_arm
  designX          Float?      // Posición relativa (%)
  designY          Float?
  designScaleX     Float?
  designScaleY     Float?
  designRotation   Float?
  quotedPrice      Decimal?    @db.Decimal(12, 4)
  merchantMessage  String?
  unfeasibleReason String?
  rejectionReason  String?
  whatsappUrl      String?
  status           QuoteStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  client           User        @relation(fields: [clientId], references: [id])
  items            QuoteItem[]
  statusHistory    QuoteStatusHistory[]
}

model QuoteItem {
  id               String         @id @default(uuid())
  quoteId          String
  productVariantId String
  quantity         Int
  quote            Quote          @relation(fields: [quoteId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model QuoteStatusHistory {
  id         String      @id @default(uuid())
  quoteId    String
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  changedBy  String
  note       String?
  createdAt  DateTime    @default(now())
  quote      Quote       @relation(fields: [quoteId], references: [id])
}

// ─── LOG DE AUDITORÍA ──────────────────────────────────────────────────────

enum AuditEventType {
  PRICE_CHANGE
  USER_MGMT
  ROLE_CHANGE
  DISCOUNT_CONFIG
  ORDER_CANCEL
  SENSITIVE_ACCESS
  STOCK_ADJUST
}

model AuditLog {
  id            String         @id @default(uuid())
  timestamp     DateTime       @default(now())
  type          AuditEventType
  userId        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  user          User           @relation("AuditUser", fields: [userId], references: [id])
  // Sin relación de Update ni Delete — append only
}

// ─── LOG DE ERRORES TÉCNICOS ───────────────────────────────────────────────

enum ErrorSeverity {
  CRITICAL
  HIGH
  MEDIUM
}

model ErrorLog {
  id          String        @id @default(uuid())
  timestamp   DateTime      @default(now())
  severity    ErrorSeverity
  type        String        // UNHANDLED_EXCEPTION | API_FAILURE | TIMEOUT | DB_ERROR
  module      String
  message     String
  stackTrace  String?       // Datos sensibles sanitizados
  isReviewed  Boolean       @default(false)
  reviewedBy  String?
  reviewedAt  DateTime?
}
