{
  "name": "coremen",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma textil comercial - Modelo Gamarra (CoreMen)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api-nest",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace=apps/api-nest",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "test:http": "npm exec --workspace=apps/api-nest ts-node --transpile-only ../../test-http.ts",
    "test:e2e": "npm exec --workspace=apps/api-nest ts-node --transpile-only ../../test-e2e.ts",
    "db:migrate": "npm run db:migrate --workspace=apps/api-nest",
    "db:seed": "npm run db:seed --workspace=apps/api-nest",
    "db:studio": "npm run db:studio --workspace=apps/api-nest",
    "db:generate": "npm run db:generate --workspace=apps/api-nest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "konva": "^10.3.0",
    "react-konva": "^19.2.5"
  }
}
